              "html": "<style>.r{position:relative;width:1920px;height:1080px;overflow:hidden;font-family:'Bricolage Grotesque',Inter,sans-serif;--a:min(clamp(0,calc((var(--cf-progress) - .12) / .1),1),clamp(0,calc((1 - var(--cf-progress)) / .14),1));--d:min(clamp(0,calc((var(--cf-progress) - .24) / .1),1),clamp(0,calc((1 - var(--cf-progress)) / .14),1))}.t{position:absolute;right:130px;top:298px;margin:0;color:var(--cf-color);font-size:148px;font-weight:800;line-height:146px;text-align:right;white-space:pre-line;opacity:var(--a)}.k{position:absolute;left:1118px;top:650px;width:672px;opacity:var(--d)}.rule{height:3px;background:var(--cf-color)}.l1{margin-top:28px;color:#f7f1e6;font-size:29px;font-weight:600;letter-spacing:2px}.l2{margin-top:14px;color:#e8d6bf;font-size:22px;letter-spacing:1.7px}.tl{position:absolute;left:112px;top:84px;color:var(--cf-color);font-size:21px;font-weight:600;letter-spacing:5px;opacity:var(--d)}.tr{position:absolute;right:112px;top:84px;display:flex;align-items:center;gap:22px;color:var(--cf-color);opacity:var(--d)}.n{font-size:17px;font-weight:600;letter-spacing:3px}.dot{width:22px;height:22px;border-radius:999px;background:var(--cf-color)}.logo{position:absolute;left:112px;bottom:76px;display:flex;align-items:center;gap:22px;opacity:var(--d)}.word{color:#f7f1e6;font-size:29px;font-weight:650;letter-spacing:1.2px}</style><div class=\"r\"><div class=\"t\">{{text}}</div><div class=\"k\"><div class=\"rule\"></div><div class=\"l1\">ONE CANVAS &middot; HUMAN + AGENT</div><div class=\"l2\">BUILT IN CUEFRAME</div></div><div class=\"tl\">YOSEMITE // UPPER FALLS</div><div class=\"tr\"><span class=\"n\">01 / 06</span><span class=\"dot\"></span></div><div class=\"logo\"><svg width=\"70\" height=\"70\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><defs><clipPath id=\"cueframe-logo-clip\"><circle cx=\"128\" cy=\"128\" r=\"118\"/></clipPath></defs><circle cx=\"128\" cy=\"128\" r=\"118\" fill=\"#eba61f\"/><g clip-path=\"url(#cueframe-logo-clip)\" stroke=\"#0a0a0a\" fill=\"none\"><path d=\"M88 128Q160 40 300-40\" stroke-width=\"5\"/><path d=\"M88 128Q170 60 310 20\" stroke-width=\"4.5\"/><path d=\"M88 128Q180 80 316 70\" stroke-width=\"4.5\"/><path d=\"M88 128Q186 110 320 110\" stroke-width=\"4.5\"/><path d=\"M88 128Q186 146 320 146\" stroke-width=\"4.5\"/><path d=\"M88 128Q180 176 316 186\" stroke-width=\"4.5\"/><path d=\"M88 128Q170 196 310 236\" stroke-width=\"4.5\"/><path d=\"M88 128Q160 216 300 296\" stroke-width=\"5\"/></g><circle cx=\"88\" cy=\"128\" r=\"20\" fill=\"#0a0a0a\"/><circle cx=\"88\" cy=\"128\" r=\"8\" fill=\"#7ec8e3\"/></svg><span class=\"word\">CUEFRAME</span></div></div>",
