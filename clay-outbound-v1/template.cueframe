              "html": "<style>\n.beat{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 9%;background:var(--cf-bg);color:var(--cf-ink);font-family:var(--cf-body),Inter,sans-serif;opacity:var(--cf-enter);transform:translateY(calc((1 - var(--cf-enter)) * 24px))}\n.beat.out{opacity:calc(var(--cf-enter) * var(--cf-exit))}\n.eyebrow{font-family:var(--cf-mono),\"JetBrains Mono\",monospace;font-size:1.6vw;letter-spacing:.18em;text-transform:uppercase;color:var(--cf-accent);margin:0 0 1.2vw}\nh1{font-family:var(--cf-heading),\"Bricolage Grotesque\",sans-serif;font-weight:650;font-size:6.4vw;line-height:1.02;letter-spacing:-.02em;margin:0;max-width:78%}\nh1 b{color:var(--cf-accent);font-weight:inherit}\np{font-size:2.2vw;line-height:1.35;margin:1.6vw 0 0;max-width:64%;color:var(--cf-ink-2)}\n.metric{font-family:var(--cf-heading),\"Bricolage Grotesque\",sans-serif;font-size:13vw;line-height:.95;letter-spacing:-.03em;color:var(--cf-accent);margin:0}\n.rule{width:calc(var(--cf-enter) * 18vw);height:.4vw;background:var(--cf-accent);margin:2vw 0 0}\n.cta{display:inline-flex;align-items:center;gap:1vw;margin-top:2.4vw;padding:1.1vw 2.2vw;border:.18vw solid var(--cf-accent);border-radius:999px;font-size:2vw;color:var(--cf-ink)}\n.from{position:absolute;left:9%;bottom:8%;font-size:1.5vw;color:var(--cf-ink-2)}\n</style><div class=\"beat out\"><p class=\"eyebrow\">{{company}}</p><h1>{{firstName}}, let us show you <b>{{outcome}}</b>.</h1><div class=\"cta\">{{cta}} →</div><p class=\"from\">{{senderName}}</p></div>",
